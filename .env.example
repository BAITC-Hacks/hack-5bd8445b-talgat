# Скопируйте в .env в корне проекта: cp .env.example .env
# Этот файл читают docker compose, backend (Express + Prisma) и frontend (Next.js).

# --- OpenAI (platform.openai.com → API keys) ---
OPENAI_API_KEY=your_openai_api_key_here
# Модель для уточняющих вопросов и сборки карточки
OPENAI_MODEL=gpt-5.6-terra
# Уровень рассуждений модели: none | low | medium
OPENAI_REASONING_EFFORT=low
# Таймаут одного запроса к OpenAI, мс
OPENAI_TIMEOUT_MS=25000

# --- PostgreSQL в Docker (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_sana
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_sana

# --- Express API ---
EXPRESS_PORT=4000
# Адрес фронтенда, которому разрешены запросы (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# --- Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:4000
